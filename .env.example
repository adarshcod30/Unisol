# ---------------------------------------------------------------------------
# SpecLedger configuration.  Copy to .env and fill in.  .env is gitignored.
# ---------------------------------------------------------------------------
# SpecLedger runs FULLY WITHOUT CREDENTIALS: the deterministic extractors, the
# evaluation and the cockpit all work offline. Credentials switch on the Claude
# extractor, which joins the panel and raises recall. It is held to exactly the
# same evidence contract -- every value it proposes is re-checked against the
# source document, so a fabricated quote is discarded regardless of backend.

# "bedrock" (default) or "anthropic"
SPECLEDGER_LLM_BACKEND=bedrock

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# only needed for temporary/STS credentials
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Must be enabled in your account for the region above. Cross-region inference
# profiles are prefixed with the region group (us. / eu. / apac.).
SPECLEDGER_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Direct Anthropic API (alternative to Bedrock) ---
# ANTHROPIC_API_KEY=
# SPECLEDGER_MODEL=claude-sonnet-4-5

# Independent samples drawn per extraction. Agreement across samples is a real
# uncertainty signal and feeds the calibrator. 1 disables self-consistency.
SPECLEDGER_LLM_SAMPLES=3

# The precision floor the business accepts on auto-published data. The calibrator
# finds the confidence threshold that achieves it. Raising this lowers the
# auto-publish rate; see the risk-coverage frontier printed by `make eval`.
SPECLEDGER_TARGET_PRECISION=0.98
SPECLEDGER_TARGET_PRECISION_SAFETY=0.99
