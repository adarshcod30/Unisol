# Optional. Without a key SpecLedger runs its deterministic extractors only --
# the full pipeline, evaluation and cockpit all work offline. Adding a key
# enables the Claude extractor, which joins the panel and raises recall.
# It is held to the same evidence contract: every value it proposes is
# re-checked against the source document, so a fabricated quote is discarded.
ANTHROPIC_API_KEY=

# Model used by the LLM extractor.
SPECLEDGER_MODEL=claude-sonnet-4-5

# The precision floor the business is willing to accept on auto-published data.
# The calibrator finds the confidence threshold that achieves it; raising this
# lowers the auto-publish rate and vice versa. See the risk-coverage frontier
# in `make eval`.
SPECLEDGER_TARGET_PRECISION=0.98
SPECLEDGER_TARGET_PRECISION_SAFETY=0.99
