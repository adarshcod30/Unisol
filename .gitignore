# --- Secrets: never commit. LLM API keys live here. ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Node / Next.js ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.npm/
.pnpm-store/

# --- Data & model artifacts (large, regenerable) ---
# NOTE: fixtures/ and data/gold/ are deliberately NOT ignored --
# the cached source corpus and the frozen gold set MUST be committed
# so `make eval` is reproducible by the judges.
*.db
*.sqlite3
data/cache/
data/scratch/
models/*.pkl
models/*.joblib
embeddings/*.npy
*.log

# --- Eval outputs (regenerated by `make eval`) ---
eval/runs/
eval/*.tmp.json

# --- Decks & binaries: keep large PPTX out of git history.
# Delete this line if you'd rather version the submission deck. ---
*.pptx

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Claude Code: local per-machine permissions, not shared ---
.claude/settings.local.json
