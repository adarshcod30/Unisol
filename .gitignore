# --- Secrets: never commit. LLM API keys live here. ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Node / Next.js ---
node_modules/
.next/
out/
!unihack/out/
dist/
build/
*.tsbuildinfo
.npm/
.pnpm-store/

# --- Data & model artifacts ---
# data/gold/ IS committed: the gold set is the basis of every metric we report.
# data/fixtures/ is NOT: vendor datasheets are copyrighted, so we pin their URLs
# and SHA-256 in specledger/corpus.py and fetch them with `make fetch`.
*.db
*.sqlite3
data/cache/
data/scratch/
data/fixtures/
data/corpus.lock.json
data/confidence_model.json
data/specledger.db
models/*.pkl
models/*.joblib
embeddings/*.npy
*.log

# --- Eval outputs (regenerated by `make eval`) ---
eval/runs/
eval/*.tmp.json

# --- Decks & binaries: keep large PPTX out of git history.
# Delete this line if you'd rather version the submission deck. ---
*.pptx

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Claude Code: local per-machine permissions, not shared ---
.claude/settings.local.json
